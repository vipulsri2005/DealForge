{
  "manifest_version": 3,
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:;" },
  "name": "DealForge — Game Deals",
  "version": "0.1.0",
  "description": "Compare PC game deals. Forge the Deal. Own the Game.",
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" },
  "permissions": ["storage", "alarms", "notifications", "activeTab"],
  "host_permissions": ["https://www.cheapshark.com/*", "https://api.frankfurter.dev/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "DealForge", "default_popup": "popup.html", "default_icon": "icons/icon.png" },
  "options_page": "dashboard.html",
  "content_scripts": [
    { "matches": ["https://www.google.com/search*", "https://google.com/search*", "https://www.google.co.in/search*", "https://store.steampowered.com/app/*"], "js": ["src/content.js"], "run_at": "document_idle" }
  ]
}
